{
  "name": "uikit-react",
  "version": "1.0.0",
  "private": true,
  "description": "React UI kit monorepo",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint",
      "prettier --check"
    ],
    "*.{json,md,css,html,yml,yaml}": [
      "prettier --check"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxlint": "1.20.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "turbo": "^2.10.9",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=16"
  }
}
